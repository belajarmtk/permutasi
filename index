    <script>
        // 1. NAVIGASI TAB PER TOPIK
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active', 'border-white', 'text-white');
                btn.classList.add('border-transparent', 'text-blue-200');
            });

            document.getElementById('tab-' + tabId).classList.add('active');
            const activeBtn = document.getElementById('btn-' + tabId);
            activeBtn.classList.add('active', 'border-white', 'text-white');
            activeBtn.classList.remove('border-transparent', 'text-blue-200');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 2. STEP-BY-STEP CONTROLLER UNTUK SEMUA CONTOH SOAL
        const stepCounters = {
            'kali-1': 1, 'kali-2': 1,
            'perm-1': 1, 'perm-2': 1,
            'komb-1': 1, 'komb-2': 1
        };

        function updateExampleSteps(key) {
            const items = document.querySelectorAll(`.step-${key}`);
            const current = stepCounters[key];
            const total = items.length;

            items.forEach((el, idx) => {
                if (idx < current) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });

            document.getElementById(`prev-${key}`).disabled = (current <= 1);
            document.getElementById(`next-${key}`).disabled = (current >= total);
        }

        function nextStep(key) {
            const total = document.querySelectorAll(`.step-${key}`).length;
            if (stepCounters[key] < total) {
                stepCounters[key]++;
                updateExampleSteps(key);
            }
        }

        function prevStep(key) {
            if (stepCounters[key] > 1) {
                stepCounters[key]--;
                updateExampleSteps(key);
            }
        }

        function allStep(key) {
            const total = document.querySelectorAll(`.step-${key}`).length;
            stepCounters[key] = total;
            updateExampleSteps(key);
        }

        // 3. BANK SOAL LATIHAN (ATURAN PERKALIAN, PERMUTASI, KOMBINASI)
        const soalLatihan = [
            {
                id: 1,
                kategori: "Aturan Perkalian",
                pertanyaan: "Andi memiliki $5$ kemeja, $4$ celana panjang, dan $3$ pasang sepatu. Banyaknya pasangan setelan pakaian lengkap (kemeja, celana, dan sepatu) berbeda yang dapat dikenakan Andi adalah ...",
                opsi: ["12 setelan", "23 setelan", "45 setelan", "60 setelan"],
                jawabanBenar: 3, // 5 * 4 * 3 = 60
                pembahasan: "Gunakan Aturan Perkalian karena ketiga komponen dipakai secara bersamaan: $5 \\times 4 \\times 3 = 60$ setelan pakaian berbeda."
            },
            {
                id: 2,
                kategori: "Aturan Perkalian (Filling Slots)",
                pertanyaan: "Dari angka-angka $0, 1, 2, 3, 4, 5$ akan disusun bilangan ratusan yang terdiri dari $3$ angka berbeda. Banyaknya bilangan ratusan yang dapat dibentuk adalah ...",
                opsi: ["100 bilangan", "120 bilangan", "150 bilangan", "180 bilangan"],
                jawabanBenar: 0, // Ratusan (tidak boleh 0): 5 cara; Puluhan: 5 cara; Satuan: 4 cara -> 5 * 5 * 4 = 100
                pembahasan: "Digit ratusan tidak boleh diisi angka $0$, sehingga ada $5$ pilihan ($1,2,3,4,5$). Digit puluhan dapat diisi oleh $0$ dan sisa angka ratusan ($5$ pilihan). Digit satuan tersisa $4$ pilihan. Total $= 5 \\times 5 \\times 4 = 100$ bilangan."
            },
            {
                id: 3,
                kategori: "Permutasi (Siklis)",
                pertanyaan: "Sebuah keluarga yang terdiri dari ayah, ibu, dan $4$ orang anak duduk mengelilingi meja makan bundar. Banyaknya susunan posisi duduk yang berbeda jika ayah dan ibu harus selalu duduk berdampingan adalah ...",
                opsi: ["24 cara", "48 cara", "120 cara", "240 cara"],
                jawabanBenar: 1, // Ayah & Ibu dianggap 1 kesatuan -> total 5 unsur siklis = (5-1)! = 4! = 24. Posisi ayah-ibu bisa ditukar 2! = 2. Total = 24 * 2 = 48
                pembahasan: "Ayah dan ibu dianggap $1$ kelompok, sehingga total ada $1 + 4 = 5$ elemen melingkar. Banyak posisi siklis $= (5 - 1)! = 4! = 24$. Posisi ayah dan ibu dapat bertukar tempat sebanyak $2! = 2$ cara. Total $= 24 \\times 2 = 48$ cara."
            },
            {
                id: 4,
                kategori: "Permutasi (Kejuaraan)",
                pertanyaan: "Dalam final lomba lari $100\\text{ meter}$ yang diikuti oleh $7$ pelari, akan diperebutkan medali Emas (Juara 1), Perak (Juara 2), dan Perunggu (Juara 3). Banyaknya susunan peraih medali yang mungkin terjadi adalah ...",
                opsi: ["35 susunan", "120 susunan", "210 susunan", "840 susunan"],
                jawabanBenar: 2, // 7P3 = 7 * 6 * 5 = 210
                pembahasan: "Urutan juara diperhatikan, sehingga digunakan Permutasi: ${}_7P_3 = \\frac{7!}{(7-3)!} = 7 \\times 6 \\times 5 = 210$ susunan."
            },
            {
                id: 5,
                kategori: "Kombinasi (Jabat Tangan)",
                pertanyaan: "Dalam suatu rapat yang dihadiri oleh $12$ peserta, setiap peserta saling berjabat tangan satu sama lain tepat satu kali. Banyaknya jabat tangan yang terjadi seluruhnya adalah ...",
                opsi: ["48 kali", "66 kali", "132 kali", "144 kali"],
                jawabanBenar: 1, // 12C2 = (12 * 11)/2 = 66
                pembahasan: "Satu jabat tangan terjadi antara $2$ orang tanpa memperhatikan urutan (A bersalaman dengan B sama dengan B bersalaman dengan A). Maka ${}_{12}C_2 = \\frac{12!}{2! \\cdot 10!} = \\frac{12 \\times 11}{2} = 66$ kali."
            },
            {
                id: 6,
                kategori: "Kombinasi Majemuk",
                pertanyaan: "Dari $7$ siswa putra dan $5$ siswa putri akan dibentuk tim delegasi beranggotakan $5$ orang yang terdiri dari $3$ putra dan $2$ putri. Banyaknya cara membentuk tim tersebut adalah ...",
                opsi: ["210 cara", "350 cara", "420 cara", "792 cara"],
                jawabanBenar: 1, // 7C3 * 5C2 = 35 * 10 = 350
                pembahasan: "Pilih $3$ putra dari $7$ putra: ${}_7C_3 = \\frac{7 \\times 6 \\times 5}{3 \\times 2 \\times 1} = 35$. Pilih $2$ putri dari $5$ putri: ${}_5C_2 = \\frac{5 \\times 4}{2 \\times 1} = 10$. Total cara $= 35 \\times 10 = 350$ cara."
            }
        ];

        function renderQuiz() {
            const container = document.getElementById('quiz-form');
            container.innerHTML = '';
            const huruf = ['A', 'B', 'C', 'D'];

            soalLatihan.forEach((soal, idx) => {
                let badgeClass = "bg-blue-100 text-blue-900";
                if (soal.kategori.includes("Permutasi")) badgeClass = "bg-indigo-100 text-indigo-900";
                if (soal.kategori.includes("Kombinasi")) badgeClass = "bg-teal-100 text-teal-900";

                let opsiHTML = '';
                soal.opsi.forEach((teks, optIdx) => {
                    opsiHTML += `
                        <label class="flex items-center p-3 border border-slate-200 rounded-lg hover:bg-blue-50/50 cursor-pointer transition">
                            <input type="radio" name="soal_${soal.id}" value="${optIdx}" class="w-4 h-4 text-blue-800 focus:ring-blue-700 mr-3">
                            <span class="font-semibold mr-2">${huruf[optIdx]}.</span>
                            <span>${teks}</span>
                        </label>
                    `;
                });

                container.innerHTML += `
                    <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/40 print-clean">
                        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                            <span class="font-bold text-blue-950">Soal Nomor ${idx + 1}</span>
                            <span class="text-xs font-semibold px-2.5 py-0.5 rounded ${badgeClass} no-print">${soal.kategori}</span>
                        </div>
                        <div class="mb-4 text-slate-800 leading-relaxed">${soal.pertanyaan}</div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            ${opsiHTML}
                        </div>
                        <div id="feedback-${soal.id}" class="quiz-feedback hidden mt-4 p-3.5 rounded-lg text-sm border"></div>
                    </div>
                `;
            });

            if (window.MathJax) MathJax.typesetPromise();
        }

        function periksaKuis() {
            let benar = 0;
            let terjawab = 0;

            soalLatihan.forEach((soal) => {
                const selected = document.querySelector(`input[name="soal_${soal.id}"]:checked`);
                const fb = document.getElementById(`feedback-${soal.id}`);
                fb.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-300', 'text-emerald-900', 'bg-rose-50', 'border-rose-300', 'text-rose-900', 'bg-amber-50', 'border-amber-300', 'text-amber-900');

                if (selected) {
                    terjawab++;
                    if (parseInt(selected.value) === soal.jawabanBenar) {
                        benar++;
                        fb.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-900');
                        fb.innerHTML = `<p class="font-bold mb-1"><i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i> Jawaban Benar!</p><p>${soal.pembahasan}</p>`;
                    } else {
                        fb.classList.add('bg-rose-50', 'border-rose-300', 'text-rose-900');
                        fb.innerHTML = `<p class="font-bold mb-1"><i class="fa-solid fa-circle-xmark text-rose-600 mr-1"></i> Kurang Tepat.</p><p>${soal.pembahasan}</p>`;
                    }
                } else {
                    fb.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-900');
                    fb.innerHTML = `<p class="font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i> Anda belum memilih jawaban untuk soal ini.</p>`;
                }
            });

            const skor = Math.round((benar / soalLatihan.length) * 100);
            const resultBox = document.getElementById('quiz-result-box');
            resultBox.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-400', 'bg-amber-50', 'border-amber-400');
            
            if (skor >= 80) {
                resultBox.classList.add('bg-emerald-50', 'border-emerald-400');
                document.getElementById('result-title').textContent = "Luar Biasa! Penguasaan Kaidah Pencacahan Sangat Baik";
            } else {
                resultBox.classList.add('bg-amber-50', 'border-amber-400');
                document.getElementById('result-title').textContent = "Terus Berlatih! Perhatikan Perbedaan Urutan pada Permutasi & Kombinasi";
            }

            document.getElementById('result-desc').textContent = `Benar ${benar} dari ${soalLatihan.length} soal (${terjawab} soal dijawab).`;
            document.getElementById('result-score').textContent = skor;

            if (window.MathJax) MathJax.typesetPromise();
            resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function resetKuis() {
            document.getElementById('quiz-form').reset();
            document.querySelectorAll('.quiz-feedback').forEach(el => el.classList.add('hidden'));
            document.getElementById('quiz-result-box').classList.add('hidden');
        }

        // 4. CETAK PDF
        function cetakPDF() {
            if (window.MathJax) {
                MathJax.typesetPromise().then(() => window.print());
            } else {
                window.print();
            }
        }

        document.addEventListener('DOMContentLoaded', renderQuiz);
    </script>
</body>
</html>
